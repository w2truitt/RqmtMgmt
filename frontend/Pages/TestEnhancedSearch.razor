@page "/test-enhanced-search"
@using RqmtMgmtShared
@using frontend.Services
@using frontend.Components.Documents
@inject IDocumentService DocumentService
@inject IJSRuntime JSRuntime

<PageTitle>Test Enhanced Section Search</PageTitle>

<div class="container">
    <div class="row mb-4">
        <div class="col">
            <h2>
                <i class="bi bi-flask me-2"></i>
                Test Enhanced Section Search
            </h2>
            <p class="text-muted">
                This page allows you to test the enhanced section search functionality with any document.
            </p>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title mb-0">
                        <i class="bi bi-file-earmark me-2"></i>
                        Select Document
                    </h5>
                </div>
                <div class="card-body">
                    @if (isLoadingDocuments)
                    {
                        <div class="text-center py-3">
                            <div class="spinner-border spinner-border-sm text-primary"></div>
                            <p class="mt-2 small text-muted">Loading documents...</p>
                        </div>
                    }
                    else if (!documents.Any())
                    {
                        <div class="text-center py-3">
                            <i class="bi bi-file-earmark-x display-4 text-muted"></i>
                            <p class="mt-2 text-muted">No documents found.</p>
                        </div>
                    }
                    else
                    {
                        <div class="mb-3">
                            <label for="documentSelect" class="form-label">Choose Document</label>
                            <select id="documentSelect" class="form-select" @bind="selectedDocumentId">
                                <option value="0">-- Select a document --</option>
                                @foreach (var doc in documents)
                                {
                                    <option value="@doc.Id">@doc.Title (ID: @doc.Id)</option>
                                }
                            </select>
                        </div>
                        
                        @if (selectedDocumentId > 0)
                        {
                            var selectedDoc = documents.FirstOrDefault(d => d.Id == selectedDocumentId);
                            if (selectedDoc != null)
                            {
                                <div class="alert alert-info">
                                    <strong>Selected:</strong> @selectedDoc.Title<br />
                                    <small class="text-muted">
                                        Type: @selectedDoc.Type | Status: @selectedDoc.Status | Version: @selectedDoc.Version
                                    </small>
                                </div>
                            }
                        }
                    }
                </div>
            </div>
        </div>
        
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title mb-0">
                        <i class="bi bi-info-circle me-2"></i>
                        Instructions
                    </h5>
                </div>
                <div class="card-body">
                    <ol class="small">
                        <li>Select a document from the dropdown</li>
                        <li>Use the search functionality to find sections</li>
                        <li>Test fuzzy matching with different similarity thresholds</li>
                        <li>Try the duplicate detection feature</li>
                        <li>View section details by clicking the "View" button</li>
                    </ol>
                    
                    <div class="mt-3">
                        <h6 class="small">Search Tips:</h6>
                        <ul class="small text-muted">
                            <li><strong>Exact Match:</strong> Finds sections with titles containing your exact search term</li>
                            <li><strong>Fuzzy Match:</strong> Finds similar titles even with typos or variations</li>
                            <li><strong>Similarity Threshold:</strong> Lower values (50%) find more matches, higher values (90%) are more strict</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @if (selectedDocumentId > 0)
    {
        <div class="row">
            <div class="col">
                <EnhancedSectionSearch DocumentId="@selectedDocumentId" 
                                       OnSectionSelected="@OnSectionSelected" />
            </div>
        </div>
    }
</div>

@code {
    private List<DocumentDto> documents = new();
    private bool isLoadingDocuments = true;
    private int selectedDocumentId = 0;

    protected override async Task OnInitializedAsync()
    {
        await LoadDocuments();
    }

    private async Task LoadDocuments()
    {
        isLoadingDocuments = true;
        try
        {
            documents = await DocumentService.GetAllAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading documents: {ex.Message}");
            documents = new();
        }
        finally
        {
            isLoadingDocuments = false;
        }
    }

    private async Task OnSectionSelected(DocumentSectionDto section)
    {
        var message = $"Selected Section Details:\n\n" +
                     $"ID: {section.Id}\n" +
                     $"Title: {section.Title}\n" +
                     $"Section Number: {section.SectionNumber ?? "Not assigned"}\n" +
                     $"Parent ID: {section.ParentSectionId?.ToString() ?? "None (Root section)"}\n" +
                     $"Order: {section.SectionOrder}\n" +
                     $"Not Applicable: {(section.IsNotApplicable ? "Yes" : "No")}\n" +
                     $"Created: {section.CreatedAt:yyyy-MM-dd HH:mm}\n";
        
        if (!string.IsNullOrEmpty(section.Description))
        {
            message += $"\nDescription: {section.Description}";
        }

        await JSRuntime.InvokeVoidAsync("alert", message);
    }
}

<style>
    .card {
        box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
        border: 1px solid rgba(0, 0, 0, 0.125);
    }
</style>