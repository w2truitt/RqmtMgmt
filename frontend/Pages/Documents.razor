@page "/documents"
@page "/projects/{ProjectId:int}/documents"
@using RqmtMgmtShared
@using frontend.Services
@inject DocumentsDataService DocumentsService
@inject IProjectContextService ProjectContextService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<PageTitle>Documents</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="mb-0">
            <i class="bi bi-file-earmark-ruled me-2"></i>
            Documents
            @if (ProjectContextService.IsInProjectContext && ProjectContextService.CurrentProject != null)
            {
                <small class="text-muted">- @ProjectContextService.CurrentProject.Name</small>
            }
        </h3>
        <p class="text-muted mb-0">Manage requirement documents (CRD, PRD, SRS)</p>
    </div>
    <button class="btn btn-primary" @onclick="CreateNewDocument">
        <i class="bi bi-plus-circle me-1"></i>
        New Document
    </button>
</div>

<!-- Document Type Filter -->
<div class="row mb-3">
    <div class="col-md-6">
        <div class="input-group">
            <span class="input-group-text">
                <i class="bi bi-funnel"></i>
            </span>
            <select class="form-select" @bind="selectedDocumentType">
                <option value="">All Document Types</option>
                <option value="@DocumentType.CRD">Customer Requirement Document (CRD)</option>
                <option value="@DocumentType.PRD">Product Requirement Document (PRD)</option>
                <option value="@DocumentType.SRS">Software Requirement Specification (SRS)</option>
            </select>
        </div>
    </div>
    <div class="col-md-6">
        <div class="input-group">
            <span class="input-group-text">
                <i class="bi bi-search"></i>
            </span>
            <input type="text" class="form-control" placeholder="Search documents..." @bind="searchTerm" @onkeyup="OnSearchKeyUp" />
        </div>
    </div>
</div>

@if (isLoading)
{
    <div class="text-center py-4">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
        <p class="mt-2 text-muted">Loading documents...</p>
    </div>
}
else if (!documents.Any())
{
    <div class="text-center py-5">
        <i class="bi bi-file-earmark-ruled display-1 text-muted"></i>
        <h4 class="mt-3">No Documents Found</h4>
        <p class="text-muted">
            @if (string.IsNullOrEmpty(searchTerm) && string.IsNullOrEmpty(selectedDocumentType))
            {
                <span>Get started by creating your first requirement document.</span>
            }
            else
            {
                <span>No documents match your current filters.</span>
            }
        </p>
        <button class="btn btn-primary mt-2" @onclick="CreateNewDocument">
            <i class="bi bi-plus-circle me-1"></i>
            Create First Document
        </button>
    </div>
}
else
{
    <div class="row">
        @foreach (var document in documents)
        {
            <div class="col-md-6 col-lg-4 mb-4">
                <div class="card h-100 document-card" @onclick="() => ViewDocument(document.Id)">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <div class="d-flex align-items-center">
                            <i class="@GetDocumentTypeIcon(document.Type) me-2"></i>
                            <span class="badge @GetDocumentTypeBadgeClass(document.Type)">@document.Type</span>
                        </div>
                        <div class="dropdown" @onclick:stopPropagation="true">
                            <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown">
                                <i class="bi bi-three-dots"></i>
                            </button>
                            <ul class="dropdown-menu">
                                <li><button class="dropdown-item" @onclick="() => ViewDocument(document.Id)" @onclick:preventDefault="true">
                                    <i class="bi bi-eye me-2"></i>View
                                </button></li>
                                <li><button class="dropdown-item" @onclick="() => EditDocument(document.Id)" @onclick:preventDefault="true">
                                    <i class="bi bi-pencil me-2"></i>Edit
                                </button></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><button class="dropdown-item text-danger" @onclick="() => DeleteDocument(document)" @onclick:preventDefault="true">
                                    <i class="bi bi-trash me-2"></i>Delete
                                </button></li>
                            </ul>
                        </div>
                    </div>
                    <div class="card-body">
                        <h5 class="card-title">@document.Title</h5>
                        @if (!string.IsNullOrEmpty(document.Objective))
                        {
                            <p class="card-text text-muted small">@document.Objective</p>
                        }
                        <div class="d-flex justify-content-between align-items-center mt-3">
                            <span class="badge @GetStatusBadgeClass(document.Status)">@document.Status</span>
                            <small class="text-muted">v@(document.Version)</small>
                        </div>
                    </div>
                    <div class="card-footer text-muted small">
                        <div class="d-flex justify-content-between">
                            <span>Created: @document.CreatedAt.ToString("MMM dd, yyyy")</span>
                            @if (document.UpdatedAt.HasValue)
                            {
                                <span>Updated: @document.UpdatedAt.Value.ToString("MMM dd, yyyy")</span>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

@code {
    [Parameter] public int? ProjectId { get; set; }

    private List<DocumentDto> documents = new();
    private string searchTerm = string.Empty;
    private string selectedDocumentType = string.Empty;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadDocuments();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (ProjectId.HasValue)
        {
            await ProjectContextService.SetCurrentProjectAsync(ProjectId.Value);
        }
        await LoadDocuments();
    }

    private async Task LoadDocuments()
    {
        isLoading = true;
        try
        {
            if (ProjectContextService.IsInProjectContext && ProjectContextService.CurrentProject != null)
            {
                documents = await DocumentsService.GetDocumentsByProjectAsync(ProjectContextService.CurrentProject.Id);
            }
            else
            {
                documents = await DocumentsService.GetDocumentsAsync();
            }

            ApplyFilters();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading documents: {ex.Message}");
            documents = new List<DocumentDto>();
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ApplyFilters()
    {
        var filteredDocuments = documents.AsEnumerable();

        if (!string.IsNullOrEmpty(selectedDocumentType) && Enum.TryParse<DocumentType>(selectedDocumentType, out var docType))
        {
            filteredDocuments = filteredDocuments.Where(d => d.Type == docType);
        }

        if (!string.IsNullOrEmpty(searchTerm))
        {
            filteredDocuments = filteredDocuments.Where(d =>
                d.Title.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
                (!string.IsNullOrEmpty(d.Objective) && d.Objective.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)));
        }

        documents = filteredDocuments.ToList();
    }

    private async Task OnDocumentTypeChanged(ChangeEventArgs e)
    {
        selectedDocumentType = e.Value?.ToString() ?? string.Empty;
        await LoadDocuments();
    }

    private async Task OnSearchKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await LoadDocuments();
        }
    }

    private void CreateNewDocument()
    {
        if (ProjectContextService.IsInProjectContext && ProjectContextService.CurrentProject != null)
        {
            Navigation.NavigateTo($"/projects/{ProjectContextService.CurrentProject.Id}/documents/new");
        }
        else
        {
            Navigation.NavigateTo("/documents/new");
        }
    }

    private void ViewDocument(int documentId)
    {
        if (ProjectContextService.IsInProjectContext && ProjectContextService.CurrentProject != null)
        {
            Navigation.NavigateTo($"/projects/{ProjectContextService.CurrentProject.Id}/documents/{documentId}");
        }
        else
        {
            Navigation.NavigateTo($"/documents/{documentId}");
        }
    }

    private void EditDocument(int documentId)
    {
        if (ProjectContextService.IsInProjectContext && ProjectContextService.CurrentProject != null)
        {
            Navigation.NavigateTo($"/projects/{ProjectContextService.CurrentProject.Id}/documents/{documentId}/edit");
        }
        else
        {
            Navigation.NavigateTo($"/documents/{documentId}/edit");
        }
    }

    private async Task DeleteDocument(DocumentDto document)
    {
        if (await JSRuntime.InvokeAsync<bool>("confirm", $"Are you sure you want to delete '{document.Title}'?"))
        {
            try
            {
                var success = await DocumentsService.DeleteDocumentAsync(document.Id);
                if (success)
                {
                    await LoadDocuments();
                }
                else
                {
                    await JSRuntime.InvokeVoidAsync("alert", "Failed to delete document. Please try again.");
                }
            }
            catch (Exception ex)
            {
                await JSRuntime.InvokeVoidAsync("alert", $"Error deleting document: {ex.Message}");
            }
        }
    }

    private string GetDocumentTypeIcon(DocumentType type) => type switch
    {
        DocumentType.CRD => "bi bi-person-check",
        DocumentType.PRD => "bi bi-box-seam",
        DocumentType.SRS => "bi bi-code-slash",
        _ => "bi bi-file-earmark-text"
    };

    private string GetDocumentTypeBadgeClass(DocumentType type) => type switch
    {
        DocumentType.CRD => "bg-success",
        DocumentType.PRD => "bg-primary",
        DocumentType.SRS => "bg-warning text-dark",
        _ => "bg-secondary"
    };

    private string GetStatusBadgeClass(DocumentStatus status) => status switch
    {
        DocumentStatus.Draft => "bg-secondary",
        DocumentStatus.InReview => "bg-warning text-dark",
        DocumentStatus.Approved => "bg-success",
        DocumentStatus.Published => "bg-info",
        _ => "bg-light text-dark"
    };
}

<style>
    .document-card {
        cursor: pointer;
        transition: transform 0.2s, box-shadow 0.2s;
    }

    .document-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 8px rgba(0,0,0,0.1);
    }

    .nav-section-header {
        font-weight: 600;
        font-size: 0.875rem;
        color: #6c757d;
        padding: 0.75rem 1rem;
        margin-top: 1rem;
        border-bottom: 1px solid #dee2e6;
    }
</style>