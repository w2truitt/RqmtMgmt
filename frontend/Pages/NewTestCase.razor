@page "/testcases/new"
@page "/testsuites/{TestSuiteId:int}/testcases/new"
@page "/projects/{ProjectId:int}/testcases/new"
@page "/projects/{ProjectId:int}/testsuites/{TestSuiteId:int}/testcases/new"
@using RqmtMgmtShared
@inject ITestCaseService TestCaseService
@inject NavigationManager Navigation

<h3>New Test Case</h3>
<TestCaseForm OnSaved="OnSaved" SuiteId="TestSuiteId" />

@code {
    [Parameter] public int? TestSuiteId { get; set; }
    [Parameter] public int? ProjectId { get; set; }

    void OnSaved()
    {
        if (TestSuiteId.HasValue && ProjectId.HasValue)
        {
            Navigation.NavigateTo($"/projects/{ProjectId}/testsuites/{TestSuiteId}/testcases");
        }
        else if (TestSuiteId.HasValue)
        {
            Navigation.NavigateTo($"/testsuites/{TestSuiteId}/testcases");
        }
        else if (ProjectId.HasValue)
        {
            Navigation.NavigateTo($"/projects/{ProjectId}/testcases");
        }
        else
        {
            Navigation.NavigateTo("/testcases");
        }
    }
}