@page "/documents/{DocumentId:int}/sections/{SectionId:int}/edit"
@page "/projects/{ProjectId:int}/documents/{DocumentId:int}/sections/{SectionId:int}/edit"
@using RqmtMgmtShared
@using frontend.Services
@inject IDocumentSectionService DocumentSectionsService
@inject IDocumentService DocumentsService
@inject IProjectContextService ProjectContextService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<PageTitle>Edit Section - @(currentSection?.Title ?? "Loading...")</PageTitle>

<div class="container-fluid">
    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <p class="mt-2 text-muted">Loading section...</p>
        </div>
    }
    else if (currentSection == null)
    {
        <div class="text-center py-5">
            <i class="bi bi-exclamation-triangle display-1 text-warning"></i>
            <h4 class="mt-3">Section Not Found</h4>
            <p class="text-muted">The requested section could not be found or you don't have permission to edit it.</p>
            <button class="btn btn-primary" @onclick="NavigateBack">
                <i class="bi bi-arrow-left me-1"></i>
                Back to Document
            </button>
        </div>
    }
    else
    {
        <!-- Header -->
        <div class="d-flex justify-content-between align-items-start mb-4">
            <div>
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item">
                            @if (ProjectId.HasValue)
                            {
                                <a href="/projects/@ProjectId/documents">Documents</a>
                            }
                            else
                            {
                                <a href="/documents">Documents</a>
                            }
                        </li>
                        <li class="breadcrumb-item">
                            @if (ProjectId.HasValue)
                            {
                                <a href="/projects/@ProjectId/documents/@DocumentId">@(document?.Title ?? "Document")</a>
                            }
                            else
                            {
                                <a href="/documents/@DocumentId">@(document?.Title ?? "Document")</a>
                            }
                        </li>
                        <li class="breadcrumb-item active" aria-current="page">Edit Section</li>
                    </ol>
                </nav>
                <h1 class="h2">Edit Section</h1>
                @if (!string.IsNullOrEmpty(currentSection.SectionNumber))
                {
                    <p class="text-muted">Section @currentSection.SectionNumber</p>
                }
            </div>
            <div class="d-flex gap-2">
                <button class="btn btn-outline-secondary" @onclick="NavigateBack">
                    <i class="bi bi-arrow-left me-1"></i>
                    Cancel
                </button>
            </div>
        </div>

        <!-- Edit Form -->
        <div class="row">
            <div class="col-lg-8">
                <div class="card">
                    <div class="card-header">
                        <h5 class="card-title mb-0">
                            <i class="bi bi-pencil me-2"></i>
                            Section Details
                        </h5>
                    </div>
                    <div class="card-body">
                        <EditForm Model="editModel" OnValidSubmit="SaveSection">
                            <DataAnnotationsValidator />
                            <ValidationSummary class="alert alert-danger" />

                            <div class="mb-3">
                                <label for="sectionTitle" class="form-label">
                                    Title <span class="text-danger">*</span>
                                </label>
                                <InputText id="sectionTitle" 
                                          class="form-control" 
                                          @bind-Value="editModel!.Title" 
                                          placeholder="Enter section title" />
                                <ValidationMessage For="@(() => editModel!.Title)" />
                            </div>

                            <div class="mb-3">
                                <label for="sectionDescription" class="form-label">Description</label>
                                <InputTextArea id="sectionDescription" 
                                              class="form-control" 
                                              rows="5" 
                                              @bind-Value="editModel!.Description" 
                                              placeholder="Enter section description or content..." />
                                <div class="form-text">
                                    Provide a detailed description of this section's purpose and content.
                                </div>
                            </div>

                            <div class="mb-3">
                                <div class="form-check">
                                    <InputCheckbox id="isNotApplicable" 
                                                  class="form-check-input" 
                                                  @bind-Value="editModel!.IsNotApplicable" />
                                    <label class="form-check-label" for="isNotApplicable">
                                        Mark as Not Applicable (N/A)
                                    </label>
                                    <div class="form-text">
                                        Use this for template sections that don't apply to this document.
                                    </div>
                                </div>
                            </div>

                            <div class="d-flex gap-2">
                                <button type="submit" class="btn btn-primary" disabled="@isSaving">
                                    @if (isSaving)
                                    {
                                        <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                    }
                                    <i class="bi bi-check-lg me-1"></i>
                                    Save Changes
                                </button>
                                <button type="button" class="btn btn-outline-secondary" @onclick="NavigateBack">
                                    Cancel
                                </button>
                            </div>
                        </EditForm>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <!-- Section Information -->
                <div class="card mb-3">
                    <div class="card-header">
                        <h6 class="card-title mb-0">
                            <i class="bi bi-info-circle me-2"></i>
                            Section Information
                        </h6>
                    </div>
                    <div class="card-body">
                        <div class="mb-2">
                            <strong>Section Number:</strong> 
                            @(currentSection.SectionNumber ?? "Auto-generated")
                        </div>
                        <div class="mb-2">
                            <strong>Level:</strong> @currentSection.Level
                        </div>
                        <div class="mb-2">
                            <strong>Order:</strong> @currentSection.SectionOrder
                        </div>
                        @if (currentSection.ParentSectionId.HasValue)
                        {
                            <div class="mb-2">
                                <strong>Parent Section:</strong> @(parentSection?.Title ?? "Loading...")
                            </div>
                        }
                        else
                        {
                            <div class="mb-2">
                                <strong>Type:</strong> Root Section
                            </div>
                        }
                        <div class="mb-2">
                            <strong>Requirements:</strong> @currentSection.RequirementCount
                        </div>
                        @if (currentSection.TotalRequirementCount != currentSection.RequirementCount)
                        {
                            <div class="mb-2">
                                <strong>Total (including subsections):</strong> @currentSection.TotalRequirementCount
                            </div>
                        }
                        <div class="mb-2">
                            <strong>Created:</strong> @currentSection.CreatedAt.ToString("MMM dd, yyyy")
                        </div>
                        @if (currentSection.UpdatedAt.HasValue)
                        {
                            <div class="mb-2">
                                <strong>Last Updated:</strong> @currentSection.UpdatedAt.Value.ToString("MMM dd, yyyy")
                            </div>
                        }
                    </div>
                </div>

                <!-- Quick Actions -->
                <div class="card">
                    <div class="card-header">
                        <h6 class="card-title mb-0">
                            <i class="bi bi-lightning me-2"></i>
                            Quick Actions
                        </h6>
                    </div>
                    <div class="card-body">
                        <div class="d-grid gap-2">
                            <button class="btn btn-outline-primary btn-sm" @onclick="ViewSection">
                                <i class="bi bi-eye me-1"></i>
                                View in Document
                            </button>
                            @if (currentSection.RequirementCount == 0 && (currentSection.ChildSections?.Count ?? 0) == 0)
                            {
                                <button class="btn btn-outline-danger btn-sm" @onclick="DeleteSection">
                                    <i class="bi bi-trash me-1"></i>
                                    Delete Section
                                </button>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public int? ProjectId { get; set; }
    [Parameter] public int DocumentId { get; set; }
    [Parameter] public int SectionId { get; set; }

    private DocumentDto? document;
    private DocumentSectionDto? currentSection;
    private DocumentSectionDto? parentSection;
    private DocumentSectionDto? editModel;
    private bool isLoading = true;
    private bool isSaving = false;

    protected override async Task OnInitializedAsync()
    {
        if (ProjectId.HasValue)
        {
            await ProjectContextService.SetCurrentProjectAsync(ProjectId.Value);
        }

        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        try
        {
            // Load section and document in parallel
            var sectionTask = DocumentSectionsService.GetByIdAsync(SectionId);
            var documentTask = DocumentsService.GetByIdAsync(DocumentId);

            await Task.WhenAll(sectionTask, documentTask);

            currentSection = await sectionTask;
            document = await documentTask;

            if (currentSection != null)
            {
                // Verify the section belongs to the document
                if (currentSection.DocumentId != DocumentId)
                {
                    currentSection = null;
                    return;
                }

                // Create edit model
                editModel = new DocumentSectionDto
                {
                    Id = currentSection.Id,
                    DocumentId = currentSection.DocumentId,
                    ParentSectionId = currentSection.ParentSectionId,
                    Title = currentSection.Title,
                    Description = currentSection.Description,
                    SectionOrder = currentSection.SectionOrder,
                    Level = currentSection.Level,
                    SectionNumber = currentSection.SectionNumber,
                    IsNotApplicable = currentSection.IsNotApplicable,
                    CreatedAt = currentSection.CreatedAt,
                    UpdatedAt = currentSection.UpdatedAt,
                    RequirementCount = currentSection.RequirementCount,
                    TotalRequirementCount = currentSection.TotalRequirementCount
                };

                // Load parent section if exists
                if (currentSection.ParentSectionId.HasValue)
                {
                    parentSection = await DocumentSectionsService.GetByIdAsync(currentSection.ParentSectionId.Value);
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading section: {ex.Message}");
            await JSRuntime.InvokeVoidAsync("console.error", "Failed to load section", ex.Message);
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SaveSection()
    {
        if (editModel == null || currentSection == null) return;

        isSaving = true;
        try
        {
            editModel.UpdatedAt = DateTime.Now;
            var success = await DocumentSectionsService.UpdateAsync(editModel);
            
            if (success)
            {
                await JSRuntime.InvokeVoidAsync("alert", "Section updated successfully!");
                NavigateBack();
            }
            else
            {
                await JSRuntime.InvokeVoidAsync("alert", "Failed to update section. Please try again.");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error saving section: {ex.Message}");
            await JSRuntime.InvokeVoidAsync("alert", $"Error saving section: {ex.Message}");
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task DeleteSection()
    {
        if (currentSection == null) return;

        var confirmMessage = $"Are you sure you want to delete the section '{currentSection.Title}'? This action cannot be undone.";
        if (await JSRuntime.InvokeAsync<bool>("confirm", confirmMessage))
        {
            try
            {
                var success = await DocumentSectionsService.DeleteAsync(currentSection.Id);
                if (success)
                {
                    await JSRuntime.InvokeVoidAsync("alert", "Section deleted successfully!");
                    NavigateBack();
                }
                else
                {
                    await JSRuntime.InvokeVoidAsync("alert", "Failed to delete section. It may have requirements or subsections.");
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error deleting section: {ex.Message}");
                await JSRuntime.InvokeVoidAsync("alert", $"Error deleting section: {ex.Message}");
            }
        }
    }

    private void ViewSection()
    {
        if (ProjectId.HasValue)
        {
            Navigation.NavigateTo($"/projects/{ProjectId}/documents/{DocumentId}");
        }
        else
        {
            Navigation.NavigateTo($"/documents/{DocumentId}");
        }
    }

    private void NavigateBack()
    {
        if (ProjectId.HasValue)
        {
            Navigation.NavigateTo($"/projects/{ProjectId}/documents/{DocumentId}");
        }
        else
        {
            Navigation.NavigateTo($"/documents/{DocumentId}");
        }
    }
}