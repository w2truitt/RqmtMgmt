@page "/testsuites"
@page "/projects/{ProjectId:int}/testsuites"
@attribute [Authorize]
@using RqmtMgmtShared
@inject ITestSuiteService TestSuiteService
@inject IProjectService ProjectService
@inject IProjectContextService ProjectContextService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<PageTitle>Test Suites</PageTitle>

<div class="container-fluid">
    @if (project != null)
    {
        <!-- Project Context Header -->
        <div class="project-context-header mb-4">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-2">
                    <li class="breadcrumb-item">
                        <a href="/projects" class="text-decoration-none">
                            <i class="bi bi-folder me-1"></i>Projects
                        </a>
                    </li>
                    <li class="breadcrumb-item active" aria-current="page">@project.Name</li>
                    <li class="breadcrumb-item active" aria-current="page">Test Suites</li>
                </ol>
            </nav>
            <h1 class="h4 mb-1">@project.Name - Test Suites</h1>
            <p class="text-muted mb-0">@project.Description</p>
        </div>
    }
    else
    {
        <!-- Global Test Suites Header -->
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1 class="h3 mb-0">
                <i class="bi bi-collection me-2"></i>Test Suites
            </h1>
        </div>
    }

    <!-- Search Controls -->
    <div class="row mb-4">
        <div class="col-md-6">
            <div class="input-group">
                <span class="input-group-text">
                    <i class="bi bi-search"></i>
                </span>
                <input type="text" class="form-control" placeholder="Search test suites..." 
                       @bind="searchTerm" @onkeypress="OnSearchKeyPress" />
                <button class="btn btn-outline-secondary" type="button" @onclick="SearchTestSuites">
                    <i class="bi bi-search me-1"></i>Search
                </button>
                @if (!string.IsNullOrEmpty(searchTerm))
                {
                    <button class="btn btn-outline-secondary" type="button" @onclick="ClearSearch">
                        <i class="bi bi-x-circle me-1"></i>Clear
                    </button>
                }
            </div>
        </div>
        <div class="col-md-3">
            <select class="form-select" @bind="sortBy" @bind:after="SortTestSuites">
                <option value="name">Name</option>
                <option value="created">Created Date</option>
                <option value="testcasecount">Test Case Count</option>
            </select>
        </div>
        <div class="col-md-3">
            <button class="btn btn-success w-100" @onclick="CreateNewTestSuite">
                <i class="bi bi-plus-circle me-1"></i>Add Test Suite
            </button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle me-2"></i>@errorMessage
            <button type="button" class="btn-close" @onclick="() => errorMessage = string.Empty"></button>
        </div>
    }

    @if (pagedResult == null)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <p class="mt-2 text-muted">Loading test suites...</p>
        </div>
    }
    else if (!pagedResult.Items.Any())
    {
        <div class="text-center py-5">
            <i class="bi bi-collection fa-3x text-muted mb-3"></i>
            <h5 class="text-muted">No Test Suites Found</h5>
            <p class="text-muted mb-0">
                @if (!string.IsNullOrEmpty(searchTerm))
                {
                    <span>No test suites match your current search for @(project != null ? "this project" : "your search criteria").</span>
                }
                else
                {
                    <span>@(project != null ? "This project doesn't have any test suites yet" : "No test suites found"). Get started by creating your first test suite.</span>
                }
            </p>
            <button class="btn btn-primary mt-3" @onclick="CreateNewTestSuite">
                <i class="bi bi-plus-circle me-1"></i>Create First Test Suite
            </button>
        </div>
    }
    else
    {
        <!-- Test Suites Table -->
        <div class="card">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th scope="col" style="width: 80px;">ID</th>
                                <th scope="col">Name</th>
                                <th scope="col">Description</th>
                                <th scope="col" style="width: 120px;">Test Cases</th>
                                <th scope="col" style="width: 150px;">Created</th>
                                <th scope="col" style="width: 200px;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var testSuite in pagedResult.Items)
                            {
                                <tr data-testid="testsuite-row">
                                    <td>
                                        <span class="badge bg-light text-dark">@testSuite.Id</span>
                                    </td>
                                    <td>
                                        <strong>@testSuite.Name</strong>
                                    </td>
                                    <td>
                                        <span class="text-muted">@(string.IsNullOrEmpty(testSuite.Description) ? "No description" : testSuite.Description)</span>
                                    </td>
                                    <td>
                                        <span class="badge @GetTestCaseCountBadgeClass(testSuite.TestCaseCount)">
                                            @testSuite.TestCaseCount test case@(testSuite.TestCaseCount != 1 ? "s" : "")
                                        </span>
                                    </td>
                                    <td>
                                        <small class="text-muted">@testSuite.CreatedAt.ToString("MMM d, yyyy")</small>
                                    </td>
                                    <td>
                                        <div class="btn-group btn-group-sm" role="group">
                                            <button class="btn btn-outline-primary" @onclick="() => ViewTestCases(testSuite.Id)" 
                                                    title="View Test Cases" data-testid="view-testcases">
                                                <i class="bi bi-list-check"></i>
                                            </button>
                                            <button class="btn btn-outline-secondary" @onclick="() => EditTestSuite(testSuite.Id)" 
                                                    title="Edit Test Suite" data-testid="edit-testsuite">
                                                <i class="bi bi-pencil"></i>
                                            </button>
                                            <button class="btn btn-outline-danger" @onclick="() => ConfirmDeleteTestSuite(testSuite)" 
                                                    title="Delete Test Suite" data-testid="delete-testsuite">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Pagination -->
        @if (pagedResult.TotalPages > 1)
        {
            <nav aria-label="Test suites pagination" class="mt-3">
                <ul class="pagination justify-content-center">
                    <li class="page-item @(pagedResult.PageNumber == 1 ? "disabled" : "")">
                        <button class="page-link" @onclick="() => GoToPage(pagedResult.PageNumber - 1)">
                            <i class="bi bi-chevron-left"></i>
                        </button>
                    </li>
                    
                    @for (int i = Math.Max(1, pagedResult.PageNumber - 2); i <= Math.Min(pagedResult.TotalPages, pagedResult.PageNumber + 2); i++)
                    {
                        <li class="page-item @(i == pagedResult.PageNumber ? "active" : "")">
                            <button class="page-link" @onclick="() => GoToPage(i)">@i</button>
                        </li>
                    }
                    
                    <li class="page-item @(pagedResult.PageNumber == pagedResult.TotalPages ? "disabled" : "")">
                        <button class="page-link" @onclick="() => GoToPage(pagedResult.PageNumber + 1)">
                            <i class="bi bi-chevron-right"></i>
                        </button>
                    </li>
                </ul>
            </nav>
        }
    }
}
</div>

@code {
    [Parameter] public int? ProjectId { get; set; }
    
    private ProjectDto? project;
    private PagedResult<TestSuiteDto>? pagedResult;
    private string? errorMessage;
    private string searchTerm = string.Empty;
    private string sortBy = "name";
    private int currentPage = 1;
    private const int pageSize = 10;

    protected override async Task OnInitializedAsync()
    {
        if (ProjectId.HasValue)
        {
            await LoadProjectAndTestSuites();
        }
        else
        {
            await LoadTestSuites();
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        // Update project context when route parameter changes
        if (ProjectId.HasValue && project?.Id != ProjectId.Value)
        {
            await LoadProjectAndTestSuites();
        }
        else if (!ProjectId.HasValue && project != null)
        {
            // Switched from project-specific to global view
            project = null;
            await ProjectContextService.ClearProjectContextAsync();
            await LoadTestSuites();
        }
    }

    private async Task LoadProjectAndTestSuites()
    {
        try
        {
            await LoadProjectContext();
            await LoadTestSuites();
        }
        catch (Exception ex)
        {
            HandleProjectLoadError(ex);
        }
    }

    private async Task LoadProjectContext()
    {
        var projectData = await ProjectService.GetProjectByIdAsync(ProjectId!.Value);
        if (projectData != null)
        {
            this.project = projectData;
            await ProjectContextService.SetCurrentProjectAsync(projectData);
        }
        else
        {
            throw new InvalidOperationException("Failed to load project");
        }
    }

    private void HandleProjectLoadError(Exception ex)
    {
        errorMessage = $"Error loading project: {ex.Message}";
        Console.WriteLine($"Error loading project {ProjectId}: {ex}");
        Navigation.NavigateTo("/projects");
    }

    private async Task LoadTestSuites()
    {
        try
        {
            var request = CreatePaginationRequest();
            var result = await FetchTestSuitesData(request);
            
            if (result != null)
            {
                pagedResult = result;
            }
            else
            {
                errorMessage = "Failed to load test suites";
            }
        }
        catch (Exception ex)
        {
            HandleTestSuitesLoadError(ex);
        }
    }

    private PaginationParameters CreatePaginationRequest()
    {
        return new PaginationParameters
        {
            PageNumber = currentPage,
            PageSize = pageSize,
            SearchTerm = searchTerm,
            SortBy = sortBy,
            ProjectId = ProjectId
        };
    }

    private async Task<PagedResult<TestSuiteDto>?> FetchTestSuitesData(PaginationParameters request)
    {
        return ProjectId.HasValue
            ? await TestSuiteService.GetPagedByProjectIdAsync(ProjectId.Value, request)
            : await TestSuiteService.GetPagedAsync(request);
    }

    private void HandleTestSuitesLoadError(Exception ex)
    {
        errorMessage = $"Error loading test suites: {ex.Message}";
        Console.WriteLine($"Error loading test suites: {ex}");
    }

    private async Task PerformSearch()
    {
        currentPage = 1;
        await LoadTestSuites();
    }

    private async Task SearchTestSuites() => await PerformSearch();
    private async Task SortTestSuites() => await PerformSearch();

    private async Task ClearSearch()
    {
        searchTerm = string.Empty;
        await PerformSearch();
    }

    private async Task GoToPage(int page)
    {
        if (IsValidPageNumber(page))
        {
            currentPage = page;
            await LoadTestSuites();
        }
    }

    private bool IsValidPageNumber(int page)
    {
        return page >= 1 && page <= (pagedResult?.TotalPages ?? 1);
    }

    private async Task OnSearchKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SearchTestSuites();
        }
    }

    private void CreateNewTestSuite()
    {
        var route = GenerateCreateRoute();
        Navigation.NavigateTo(route);
    }

    private string GenerateCreateRoute()
    {
        return ProjectId.HasValue 
            ? $"/projects/{ProjectId}/testsuites/new"
            : "/testsuites/new";
    }

    private void ViewTestCases(int testSuiteId)
    {
        var route = GenerateTestCasesRoute(testSuiteId);
        Navigation.NavigateTo(route);
    }

    private string GenerateTestCasesRoute(int testSuiteId)
    {
        return ProjectId.HasValue 
            ? $"/projects/{ProjectId}/testsuites/{testSuiteId}/testcases"
            : $"/testsuites/{testSuiteId}/testcases";
    }

    private void EditTestSuite(int testSuiteId)
    {
        var route = GenerateEditRoute(testSuiteId);
        Navigation.NavigateTo(route);
    }

    private string GenerateEditRoute(int testSuiteId)
    {
        return ProjectId.HasValue 
            ? $"/projects/{ProjectId}/testsuites/{testSuiteId}/edit"
            : $"/testsuites/{testSuiteId}/edit";
    }

    private void ConfirmDeleteTestSuite(TestSuiteDto testSuite)
    {
        LogDeleteAction(testSuite);
        // TODO: Implement delete confirmation modal
    }

    private void LogDeleteAction(TestSuiteDto testSuite)
    {
        Console.WriteLine($"Delete test suite {testSuite.Id}: {testSuite.Name}");
    }

    private string GetTestCaseCountBadgeClass(int count)
    {
        return GetCountBadgeClassByRange(count);
    }

    private string GetCountBadgeClassByRange(int count)
    {
        return count switch
        {
            0 => "bg-warning text-dark",
            <= 5 => "bg-info",
            <= 20 => "bg-success",
            _ => "bg-primary"
        };
    }
}

<style>
.project-context-header {
    background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
    padding: 1.5rem;
    border-radius: 0.5rem;
    border-left: 4px solid var(--bs-primary);
}

.btn-group-sm .btn {
    padding: 0.25rem 0.4rem;
}

.table > :not(caption) > * > * {
    padding: 0.75rem 0.5rem;
}

.page-link {
    border: none;
    color: var(--bs-primary);
}

.page-link:hover {
    background-color: var(--bs-light);
    color: var(--bs-primary);
}

.page-item.active .page-link {
    background-color: var(--bs-primary);
    border-color: var(--bs-primary);
}
</style>
