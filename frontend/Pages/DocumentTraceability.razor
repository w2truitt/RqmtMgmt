@page "/documents/{DocumentId:int}/traceability"
@page "/projects/{ProjectId:int}/documents/{DocumentId:int}/traceability"
@using RqmtMgmtShared
@using frontend.Services
@using frontend.Components.Traceability
@inject IDocumentService DocumentsService
@inject IRequirementTraceService TracesService
@inject NavigationManager Navigation
@inject IProjectContextService ProjectContextService

<PageTitle>Traceability Matrix - @(document?.Title ?? "Document")</PageTitle>

<div class="container-fluid">
    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <p class="mt-2 text-muted">Loading document...</p>
        </div>
    }
    else if (document == null)
    {
        <div class="text-center py-5">
            <i class="bi bi-file-earmark-x display-1 text-muted"></i>
            <h4 class="mt-3">Document Not Found</h4>
            <p class="text-muted">The requested document could not be found.</p>
            <button class="btn btn-primary" @onclick="NavigateBack">
                <i class="bi bi-arrow-left me-1"></i>
                Back to Document
            </button>
        </div>
    }
    else
    {
        <!-- Page Header -->
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2 class="mb-1">
                    <i class="bi bi-diagram-3 me-2"></i>
                    Traceability Matrix
                </h2>
                <p class="text-muted mb-0">
                    <span class="badge @GetDocumentTypeBadgeClass(document.Type) me-2">@document.Type</span>
                    @document.Title
                </p>
            </div>
            <div class="d-flex gap-2">
                <button class="btn btn-outline-secondary" @onclick="NavigateBack">
                    <i class="bi bi-arrow-left me-1"></i>
                    Back to Document
                </button>
            </div>
        </div>

        <!-- Traceability Matrix Component -->
        <TraceabilityMatrix DocumentId="@DocumentId" 
                           Direction="@selectedDirection"
                           OnAddTrace="HandleAddTrace"
                           OnDeleteTrace="HandleDeleteTrace" />
    }
</div>

@code {
    [Parameter] public int? ProjectId { get; set; }
    [Parameter] public int DocumentId { get; set; }

    private DocumentDto? document;
    private bool isLoading = true;
    private string selectedDirection = "downstream";

    protected override async Task OnInitializedAsync()
    {
        if (ProjectId.HasValue)
        {
            await ProjectContextService.SetCurrentProjectAsync(ProjectId.Value);
        }

        await LoadDocument();
    }

    private async Task LoadDocument()
    {
        isLoading = true;
        try
        {
            document = await DocumentsService.GetByIdAsync(DocumentId);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading document: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void NavigateBack()
    {
        if (document == null) return;

        if (ProjectContextService.IsInProjectContext && ProjectContextService.CurrentProject != null)
        {
            Navigation.NavigateTo($"/projects/{ProjectContextService.CurrentProject.Id}/documents/{document.Id}");
        }
        else
        {
            Navigation.NavigateTo($"/documents/{document.Id}");
        }
    }

    private Task HandleAddTrace(int sourceRequirementId)
    {
        // TODO: Implement add trace dialog/modal
        // For now, just log the action
        Console.WriteLine($"Add trace requested for requirement {sourceRequirementId}");
        return Task.CompletedTask;
        
        // In a full implementation, this would open a modal to select target requirement
        // and create the trace link via TracesService.CreateRequirementTraceAsync()
    }

    private async Task HandleDeleteTrace(int traceId)
    {
        try
        {
            var success = await TracesService.DeleteAsync(traceId);
            if (success)
            {
                Console.WriteLine($"Trace {traceId} deleted successfully");
                // The TraceabilityMatrix component will refresh automatically
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error deleting trace: {ex.Message}");
        }
    }

    private string GetDocumentTypeBadgeClass(DocumentType type) => type switch
    {
        DocumentType.CRD => "bg-success",
        DocumentType.PRD => "bg-primary",
        DocumentType.SRS => "bg-warning text-dark",
        _ => "bg-secondary"
    };
}