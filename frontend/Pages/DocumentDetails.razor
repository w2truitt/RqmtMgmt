@page "/documents/{DocumentId:int}"
@page "/projects/{ProjectId:int}/documents/{DocumentId:int}"
@using RqmtMgmtShared
@using frontend.Services
@using frontend.Components.Traceability
@using frontend.Components.Documents
@inject IDocumentSectionService DocumentSectionsService
@inject IRequirementService RequirementsService
@inject IDocumentService DocumentsService
@inject IJSRuntime JSRuntime
@inject IProjectContextService ProjectContextService
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation

<PageTitle>@(document?.Title ?? "Document Details")</PageTitle>

<div class="container-fluid @(isReadingMode ? "reading-mode" : "")">
    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <p class="mt-2 text-muted">Loading document...</p>
        </div>
    }
    else if (document == null)
    {
        <div class="text-center py-5">
            <i class="bi bi-file-earmark-x display-1 text-muted"></i>
            <h4 class="mt-3">Document Not Found</h4>
            <p class="text-muted">The requested document could not be found.</p>
            <button class="btn btn-primary" @onclick="NavigateToDocuments">
                <i class="bi bi-arrow-left me-1"></i>
                Back to Documents
            </button>
        </div>
    }
    else
    {
        <!-- Document Header with Actions and View Mode Toggle -->
        <div class="document-header d-flex justify-content-between align-items-start mb-4 @(isReadingMode ? "d-print-block" : "no-print")">
            <div class="flex-grow-1">
                <div class="d-flex align-items-center mb-2">
                    <span class="badge @GetDocumentTypeBadgeClass(document.Type) me-2">@GetDocumentTypeDisplayName(document!.Type)</span>
                    <span class="badge @GetStatusBadgeClass(document.Status) me-2">@document.Status</span>
                    <small class="text-muted">Version @(document.Version)</small>
                </div>
                <h1 class="document-title mb-1">@document.Title</h1>
                <p class="text-muted mb-0">Project: @document.ProjectId</p>
            </div>
            <div class="d-flex gap-2 ms-3 @(isReadingMode ? "d-print-none" : "")">
                <button class="btn @(isReadingMode ? "btn-primary" : "btn-outline-primary")" @onclick="ToggleViewMode">
                    <i class="bi @(isReadingMode ? "bi-pencil" : "bi-book") me-1"></i>
                    @(isReadingMode ? "Edit Mode" : "Reading Mode")
                </button>
                @if (!isReadingMode)
                {
                    <button class="btn btn-outline-primary" @onclick="EditDocument">
                        <i class="bi bi-pencil me-1"></i>
                        Edit Document
                    </button>
                    <button class="btn btn-outline-success" @onclick="AddRequirement">
                        <i class="bi bi-plus-circle me-1"></i>
                        Add Requirement
                    </button>
                }
                <button class="btn btn-outline-secondary" @onclick="NavigateToDocuments">
                    <i class="bi bi-arrow-left me-1"></i>
                    Back to Documents
                </button>
            </div>
        </div>

        <!-- Document Metadata Section -->
        <div class="document-section mb-4">
            <div class="row mb-3">
                <div class="col-md-6">
                    <div class="metadata-item">
                        <strong>Document Type:</strong> @GetDocumentTypeDisplayName(document!.Type)
                    </div>
                    <div class="metadata-item">
                        <strong>Status:</strong> @document.Status
                    </div>
                    <div class="metadata-item">
                        <strong>Version:</strong> @document.Version
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="metadata-item">
                        <strong>Created:</strong> @document.CreatedAt.ToString("MMM dd, yyyy")
                    </div>
                    @if (document.UpdatedAt.HasValue)
                    {
                        <div class="metadata-item">
                            <strong>Updated:</strong> @document.UpdatedAt.Value.ToString("MMM dd, yyyy")
                        </div>
                    }
                    <div class="metadata-item">
                        <strong>Requirements:</strong> @requirements.Count | <strong>Sections:</strong> @sections.Count
                    </div>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(document.Objective))
            {
                <div class="content-section mb-4">
                    <h3 class="section-title">Objective</h3>
                    <p class="content-text">@document.Objective</p>
                </div>
            }

            @if (!string.IsNullOrEmpty(document.Background))
            {
                <div class="content-section mb-4">
                    <h3 class="section-title">Background & Context</h3>
                    <p class="content-text">@document.Background</p>
                </div>
            }

            @if (!string.IsNullOrEmpty(document.SuccessCriteria))
            {
                <div class="content-section mb-4">
                    <h3 class="section-title">Success Criteria</h3>
                    <p class="content-text">@document.SuccessCriteria</p>
                </div>
            }

            @if (!string.IsNullOrEmpty(document.Dependencies))
            {
                <div class="content-section mb-4">
                    <h3 class="section-title">Dependencies</h3>
                    <p class="content-text">@document.Dependencies</p>
                </div>
            }
        </div>

        <!-- Document Sections Management -->
        @if (!isReadingMode)
        {
            <div class="document-section mb-4">
                <HierarchicalSectionManager DocumentId="@DocumentId" OnSectionsChanged="OnSectionsChanged" />
            </div>
        }

        <!-- Document Sections with Requirements using Recursive Component -->
        @if (sections.Any())
        {
            @foreach (var rootSection in sections.Where(s => s.ParentSectionId == null).OrderBy(s => s.SectionOrder))
            {
                <RecursiveDocumentSection 
                    Section="rootSection" 
                    AllRequirements="requirements"
                    IsReadingMode="isReadingMode"
                    OnEditSection="EditSection"
                    OnEditRequirement="ViewRequirement"
                    OnAddRequirement="AddRequirementToSection"
                    Level="0" />
            }
        }
        }

        <!-- Standalone Requirements (not assigned to sections) -->
        @if (requirements.Where(r => r.SectionId == 0).Any())
        {
            var standaloneRequirements = requirements.Where(r => r.SectionId == 0).ToList();
            <div class="document-section mb-5">
                <h2 class="section-header">Additional Requirements</h2>
                <p class="section-description">Requirements not assigned to specific sections</p>
                
                <div class="requirements-in-section mt-3">
                    @foreach (var requirement in standaloneRequirements)
                    {
                        <div class="requirement-item mb-3 p-3 border-start border-3 border-secondary bg-light">
                            <div class="d-flex justify-content-between align-items-start">
                                <div class="flex-grow-1">
                                    <h5 class="requirement-title mb-1">@requirement.Title</h5>
                                    <div class="requirement-meta mb-2">
                                        <span class="badge bg-secondary me-2">@requirement.Type</span>
                                        <span class="badge @GetRequirementStatusBadgeClass(requirement.Status)">@requirement.Status</span>
                                    </div>
                                    @if (!string.IsNullOrEmpty(requirement.Description))
                                    {
                                        <p class="requirement-description mb-0">@requirement.Description</p>
                                    }
                                </div>
                                @if (!isReadingMode)
                                {
                                    <button class="btn btn-sm btn-outline-primary no-print" @onclick="() => ViewRequirement(requirement.Id)">
                                        View Details
                                    </button>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        }

        <!-- Traceability Analysis with TraceabilityMatrix Component -->
        @if (requirements.Any())
        {
            <div class="document-section mt-5 mb-5">
                <h2 class="section-header">
                    <i class="bi bi-diagram-3 me-2"></i>
                    Requirements Traceability Analysis
                </h2>
                <p class="section-description">
                    Track requirement relationships and coverage for this @GetDocumentTypeDisplayName(document!.Type)
                </p>
                
                <TraceabilityMatrix DocumentId="DocumentId" />
            </div>
        }
    }
</div>

@code {
    [Parameter] public int? ProjectId { get; set; }
    [Parameter] public int DocumentId { get; set; }

    private DocumentDto? document;
    private List<DocumentSectionDto> sections = new();
    private List<RequirementDto> requirements = new();
    private bool isLoading = true;
    private bool isReadingMode = false;

    protected override async Task OnInitializedAsync()
    {
        if (ProjectId.HasValue)
        {
            await ProjectContextService.SetCurrentProjectAsync(ProjectId.Value);
        }

        await LoadDocument();
    }

    private async Task LoadDocument()
    {
        isLoading = true;
        try
        {
            document = await DocumentsService.GetByIdAsync(DocumentId);
            
            if (document != null)
            {
                // Load sections and requirements in parallel
                var sectionsTask = DocumentSectionsService.GetSectionHierarchyAsync(DocumentId);
                var requirementsTask = RequirementsService.GetByDocumentIdAsync(DocumentId);
                
                await Task.WhenAll(sectionsTask, requirementsTask);
                
                sections = await sectionsTask ?? new List<DocumentSectionDto>();
                requirements = await requirementsTask ?? new List<RequirementDto>();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading document: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ToggleViewMode()
    {
        isReadingMode = !isReadingMode;
    }

    private void EditDocument()
    {
        if (document == null) return;

        if (ProjectContextService.IsInProjectContext && ProjectContextService.CurrentProject != null)
        {
            Navigation.NavigateTo($"/projects/{ProjectContextService.CurrentProject.Id}/documents/{document.Id}/edit");
        }
        else
        {
            Navigation.NavigateTo($"/documents/{document.Id}/edit");
        }
    }

    private void EditSection(int sectionId)
    {
        if (document == null) return;

        if (ProjectContextService.IsInProjectContext && ProjectContextService.CurrentProject != null)
        {
            Navigation.NavigateTo($"/projects/{ProjectContextService.CurrentProject.Id}/documents/{document.Id}/sections/{sectionId}/edit");
        }
        else
        {
            Navigation.NavigateTo($"/documents/{document.Id}/sections/{sectionId}/edit");
        }
    }

    private void AddRequirement()
    {
        if (document == null) return;

        if (ProjectContextService.IsInProjectContext && ProjectContextService.CurrentProject != null)
        {
            Navigation.NavigateTo($"/projects/{ProjectContextService.CurrentProject.Id}/requirements/new?documentId={document.Id}");
        }
        else
        {
            Navigation.NavigateTo($"/requirements/new?documentId={document.Id}");
        }
    }

    private void AddRequirementToSection(int sectionId)
    {
        if (document == null) return;

        if (ProjectContextService.IsInProjectContext && ProjectContextService.CurrentProject != null)
        {
            Navigation.NavigateTo($"/projects/{ProjectContextService.CurrentProject.Id}/requirements/new?documentId={document.Id}&sectionId={sectionId}");
        }
        else
        {
            Navigation.NavigateTo($"/requirements/new?documentId={document.Id}&sectionId={sectionId}");
        }
    }

    private void ViewRequirement(int requirementId)
    {
        if (ProjectContextService.IsInProjectContext && ProjectContextService.CurrentProject != null)
        {
            Navigation.NavigateTo($"/projects/{ProjectContextService.CurrentProject.Id}/requirements/{requirementId}");
        }
        else
        {
            Navigation.NavigateTo($"/requirements/{requirementId}");
        }
    }

    private void NavigateToDocuments()
    {
        if (ProjectContextService.IsInProjectContext && ProjectContextService.CurrentProject != null)
        {
            Navigation.NavigateTo($"/projects/{ProjectContextService.CurrentProject.Id}/documents");
        }
        else
        {
            Navigation.NavigateTo("/documents");
        }
    }

    private async Task OnSectionsChanged()
    {
        // Reload sections when they change
        sections = await DocumentSectionsService.GetSectionHierarchyAsync(DocumentId) ?? new List<DocumentSectionDto>();
        StateHasChanged();
    }

    private string GetDocumentTypeDisplayName(DocumentType type) => type switch
    {
        DocumentType.CRD => "Customer Requirement Document",
        DocumentType.PRD => "Product Requirement Document", 
        DocumentType.SRS => "Software Requirement Specification",
        _ => type.ToString()
    };

    private string GetDocumentTypeBadgeClass(DocumentType type) => type switch
    {
        DocumentType.CRD => "bg-success",
        DocumentType.PRD => "bg-primary",
        DocumentType.SRS => "bg-warning text-dark",
        _ => "bg-secondary"
    };

    private string GetStatusBadgeClass(DocumentStatus status) => status switch
    {
        DocumentStatus.Draft => "bg-secondary",
        DocumentStatus.InReview => "bg-warning text-dark",
        DocumentStatus.Approved => "bg-success",
        DocumentStatus.Published => "bg-info",
        _ => "bg-light text-dark"
    };

    private string GetRequirementStatusBadgeClass(RequirementStatus status) => status switch
    {
        RequirementStatus.Draft => "bg-secondary",
        RequirementStatus.Approved => "bg-success",
        RequirementStatus.Implemented => "bg-primary",
        RequirementStatus.Verified => "bg-info",
        _ => "bg-light text-dark"
    };
}