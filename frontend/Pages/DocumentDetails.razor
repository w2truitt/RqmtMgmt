@page "/documents/{DocumentId:int}"
@page "/projects/{ProjectId:int}/documents/{DocumentId:int}"
@using RqmtMgmtShared
@using frontend.Services
@inject DocumentSectionsDataService DocumentSectionsService
@inject IRequirementService RequirementsService
@using frontend.Components
@using frontend.Components.Documents
@inject DocumentsDataService DocumentsService
@inject IJSRuntime JSRuntime
@inject IProjectContextService ProjectContextService
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation

<PageTitle>@(document?.Title ?? "Document Details")</PageTitle>

<div class="container-fluid">
    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <p class="mt-2 text-muted">Loading document...</p>
        </div>
    }
    else if (document == null)
    {
        <div class="text-center py-5">
            <i class="bi bi-file-earmark-x display-1 text-muted"></i>
            <h4 class="mt-3">Document Not Found</h4>
            <p class="text-muted">The requested document could not be found.</p>
            <button class="btn btn-primary" @onclick="NavigateToDocuments">
                <i class="bi bi-arrow-left me-1"></i>
                Back to Documents
            </button>
        </div>
    }
    else
    {
        <!-- Document Header -->
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <div class="d-flex align-items-center mb-2">
                    <span class="badge @GetDocumentTypeBadgeClass(document.Type) me-2">@document.Type</span>
                    <span class="badge @GetStatusBadgeClass(document.Status)">@document.Status</span>
                    <small class="text-muted ms-2">v@(document.Version)</small>
                </div>
                <h2 class="mb-0">@document.Title</h2>
                <p class="text-muted mb-0">@document.ProjectName</p>
            </div>
            <div class="d-flex gap-2">
                <button class="btn btn-outline-primary" @onclick="EditDocument">
                    <i class="bi bi-pencil me-1"></i>
                    Edit
                </button>
                <button class="btn btn-outline-secondary" @onclick="NavigateToDocuments">
                    <i class="bi bi-arrow-left me-1"></i>
                    Back to Documents
                </button>
            </div>
        </div>

        <div class="row">
            <div class="col-lg-8">
                <!-- Document Content -->
                <div class="card">
                    <div class="card-header">
                        <h5 class="card-title mb-0">
                            <i class="bi bi-file-text me-2"></i>
                            Document Information
                        </h5>
                    </div>
                    <div class="card-body">
                        @if (!string.IsNullOrEmpty(document.Objective))
                        {
                            <div class="mb-4">
                                <h6 class="text-primary">Objective</h6>
                                <p class="mb-0">@document.Objective</p>
                            </div>
                        }

                        @if (!string.IsNullOrEmpty(document.Background))
                        {
                            <div class="mb-4">
                                <h6 class="text-primary">Background & Context</h6>
                                <p class="mb-0">@document.Background</p>
                            </div>
                        }

                        @if (!string.IsNullOrEmpty(document.SuccessCriteria))
                        {
                            <div class="mb-4">
                                <h6 class="text-primary">Success Criteria</h6>
                                <p class="mb-0">@document.SuccessCriteria</p>
                            </div>
                        }

                        @if (!string.IsNullOrEmpty(document.Dependencies))
                        {
                            <div class="mb-4">
                                <h6 class="text-primary">Dependencies</h6>
                                <p class="mb-0">@document.Dependencies</p>
                            </div>
                        }
                    </div>
                </div>

                <!-- Document Sections Management -->
                <div class="mt-4">
                    <SectionManager DocumentId="@DocumentId" OnSectionsChanged="OnSectionsChanged" />
                </div>

                <!-- Related Requirements -->
                @if (requirements.Any())
                {
                    <div class="card mt-4">
                        <div class="card-header">
                            <h5 class="card-title mb-0">
                                <i class="bi bi-list-check me-2"></i>
                                Related Requirements (@requirements.Count)
                            </h5>
                        </div>
                        <div class="card-body">
                            @foreach (var requirement in requirements)
                            {
                                <div class="d-flex justify-content-between align-items-center border-bottom py-2">
                                    <div>
                                        <h6 class="mb-1">@requirement.Title</h6>
                                        <small class="text-muted">@requirement.Type - @requirement.Status</small>
                                        @if (requirement.SectionId.HasValue)
                                        {
                                            var sec = sections.FirstOrDefault(s => s.Id == requirement.SectionId.Value);
                                            if (sec != null)
                                            {
                                                <span class="badge bg-light text-dark ms-2">@sec.Title</span>
                                            }
                                        }
                                    </div>
                                    <button class="btn btn-sm btn-outline-primary" @onclick="() => ViewRequirement(requirement.Id)">
                                        View
                                    </button>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
                <!-- Document Editor Preview -->
                <div class="card mt-4">
                    <div class="card-header">
                        <h5 class="card-title mb-0">
                            <i class="bi bi-magic me-2"></i>
                            Document Editor Preview
                        </h5>
                    </div>
                    <div class="card-body">
                        <p class="text-muted mb-3">
                            <strong>Phase 3A:</strong> Inline editing demonstration - click requirements to edit them directly.
                        </p>
                        
                        @if (sections.Any())
                        {
                            var firstSection = sections.OrderBy(s => s.SectionOrder).First();
                            var sectionRequirements = requirements.Where(r => r.SectionId == firstSection.Id).Take(2).ToList();
                            
                            <h6 class="text-primary mb-3">@firstSection.SectionOrder. @firstSection.Title</h6>
                            
                            @if (sectionRequirements.Any())
                            {
                                @foreach (var requirement in sectionRequirements)
                                {
                                    <InlineRequirement Requirement="@requirement"
                                                     OnUpdate="HandleRequirementUpdate"
                                                     OnDelete="HandleRequirementDelete" />
                                }
                            }
                            
                            @if (showAddRequirementForSection == firstSection.Id)
                            {
                                <div class="mt-3 p-3 bg-light rounded">
                                    <InlineRequirement Requirement="@newRequirement"
                                                     OnUpdate="HandleNewRequirementSaved"
                                                     AllowDelete="false" />
                                    <button class="btn btn-sm btn-secondary mt-2" @onclick="CancelAddRequirement">
                                        Cancel
                                    </button>
                                </div>
                            }
                            else
                            {
                                <button class="btn btn-outline-primary btn-sm w-100 mt-2" 
                                        @onclick="() => ShowAddRequirement(firstSection.Id)">
                                    <i class="bi bi-plus me-1"></i>Add Requirement
                                </button>
                            }
                        }
                        else
                        {
                            <div class="text-center text-muted">
                                <i class="bi bi-info-circle me-1"></i>
                                Add sections to this document to see the inline editing preview.
                            </div>
                        }
                    </div>
                </div>
            <div class="col-lg-4">
                <!-- Document Metadata -->
                <div class="card">
                    <div class="card-header">
                        <h5 class="card-title mb-0">
                            <i class="bi bi-info-circle me-2"></i>
                            Document Details
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="row mb-2">
                            <div class="col-5"><strong>Type:</strong></div>
                            <div class="col-7">@GetDocumentTypeDisplayName(document.Type)</div>
                        </div>
                        <div class="row mb-2">
                            <div class="col-5"><strong>Status:</strong></div>
                            <div class="col-7">@document.Status</div>
                        </div>
                        <div class="row mb-2">
                            <div class="col-5"><strong>Version:</strong></div>
                            <div class="col-7">@document.Version</div>
                        </div>
                        <div class="row mb-2">
                            <div class="col-5"><strong>Created:</strong></div>
                            <div class="col-7">@document.CreatedAt.ToString("MMM dd, yyyy")</div>
                        </div>
                        @if (document.UpdatedAt.HasValue)
                        {
                            <div class="row mb-2">
                                <div class="col-5"><strong>Updated:</strong></div>
                                <div class="col-7">@document.UpdatedAt.Value.ToString("MMM dd, yyyy")</div>
                            </div>
                        }
                    </div>
                </div>

                <!-- Quick Actions -->
                <div class="card mt-3">
                    <div class="card-header">
                        <h5 class="card-title mb-0">
                            <i class="bi bi-lightning me-2"></i>
                            Quick Actions
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="d-grid gap-2">
                            <button class="btn btn-primary" @onclick="EditDocument">
                                <i class="bi bi-pencil me-2"></i>
                                Edit Document
                            </button>
                            <button class="btn btn-outline-success" @onclick="AddRequirement">
                                <i class="bi bi-plus-circle me-2"></i>
                                Add Requirement
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Document Statistics -->
                <div class="card mt-3">
                    <div class="card-header">
                        <h5 class="card-title mb-0">
                            <i class="bi bi-graph-up me-2"></i>
                            Statistics
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="row text-center">
                            <div class="col-6">
                                <div class="h4 text-primary mb-0">@sections.Count</div>
                                <small class="text-muted">Sections</small>
                            </div>
                            <div class="col-6">
                                <div class="h4 text-success mb-0">@requirements.Count</div>
                                <small class="text-muted">Requirements</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public int? ProjectId { get; set; }
    [Parameter] public int DocumentId { get; set; }

    private DocumentDto? document;
    private List<DocumentSectionDto> sections = new();
    private List<RequirementDto> requirements = new();
    private bool isLoading = true;
    private int? showAddRequirementForSection = null;
    private RequirementDto newRequirement = new() { Title = "" };

    protected override async Task OnInitializedAsync()
    {
        if (ProjectId.HasValue)
        {
            await ProjectContextService.SetCurrentProjectAsync(ProjectId.Value);
        }

        await LoadDocument();
    }

    private async Task LoadDocument()
    {
        isLoading = true;
        try
        {
            document = await DocumentsService.GetDocumentByIdAsync(DocumentId);
            
            if (document != null)
            {
                // Load sections and requirements in parallel
                var sectionsTask = DocumentSectionsService.GetDocumentSectionsAsync(DocumentId);
                var requirementsTask = RequirementsService.GetByDocumentIdAsync(DocumentId);
                
                await Task.WhenAll(sectionsTask, requirementsTask);
                
                sections = await sectionsTask;
                requirements = await requirementsTask;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading document: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task OnSectionsChanged()
    {
        // Reload sections when they change
        sections = await DocumentSectionsService.GetDocumentSectionsAsync(DocumentId);
        StateHasChanged();
    }

    private void EditDocument()
    {
        if (document == null) return;

        if (ProjectContextService.IsInProjectContext && ProjectContextService.CurrentProject != null)
        {
            Navigation.NavigateTo($"/projects/{ProjectContextService.CurrentProject.Id}/documents/{document.Id}/edit");
        }
        else
        {
            Navigation.NavigateTo($"/documents/{document.Id}/edit");
        }
    }

    private void AddRequirement()
    {
        if (document == null) return;

        if (ProjectContextService.IsInProjectContext && ProjectContextService.CurrentProject != null)
        {
            Navigation.NavigateTo($"/projects/{ProjectContextService.CurrentProject.Id}/requirements/new?documentId={document.Id}");
        }
        else
        {
            Navigation.NavigateTo($"/requirements/new?documentId={document.Id}");
        }
    }

    private void ViewRequirement(int requirementId)
    {
        if (ProjectContextService.IsInProjectContext && ProjectContextService.CurrentProject != null)
        {
            Navigation.NavigateTo($"/projects/{ProjectContextService.CurrentProject.Id}/requirements/{requirementId}");
        }
        else
        {
            Navigation.NavigateTo($"/requirements/{requirementId}");
        }
    }

    private void NavigateToDocuments()
    {
        if (ProjectContextService.IsInProjectContext && ProjectContextService.CurrentProject != null)
        {
            Navigation.NavigateTo($"/projects/{ProjectContextService.CurrentProject.Id}/documents");
        }
        else
        {
            Navigation.NavigateTo("/documents");
        }
    }

    private string GetDocumentTypeDisplayName(DocumentType type) => type switch
    {
        DocumentType.CRD => "Customer Requirement Document",
        DocumentType.PRD => "Product Requirement Document", 
        DocumentType.SRS => "Software Requirement Specification",
        _ => type.ToString()
    };

    private string GetDocumentTypeBadgeClass(DocumentType type) => type switch
    {
        DocumentType.CRD => "bg-success",
        DocumentType.PRD => "bg-primary",
        DocumentType.SRS => "bg-warning text-dark",
        _ => "bg-secondary"
    };

    private string GetStatusBadgeClass(DocumentStatus status) => status switch
    {
        DocumentStatus.Draft => "bg-secondary",
        DocumentStatus.InReview => "bg-warning text-dark",
        DocumentStatus.Approved => "bg-success",
        DocumentStatus.Published => "bg-info",
        _ => "bg-light text-dark"
    };
    
    private void ShowAddRequirement(int sectionId)
    {
        showAddRequirementForSection = sectionId;
        newRequirement = new RequirementDto
        {
            Title = "",
            DocumentId = DocumentId,
            SectionId = sectionId,
            ProjectId = document?.ProjectId ?? 0,
            Status = RequirementStatus.Draft,
            Type = RequirementType.SRS,
            CreatedAt = DateTime.UtcNow,
            CreatedBy = 1, // TODO: Get actual user ID from authentication
            ProjectName = document?.ProjectName ?? ""
        };
        StateHasChanged();
    }

    private void CancelAddRequirement()
    {
        showAddRequirementForSection = null;
        newRequirement = new RequirementDto { Title = "" };
        StateHasChanged();
    }

    private void HandleNewRequirementSaved(RequirementDto savedRequirement)
    {
        requirements.Add(savedRequirement);
        showAddRequirementForSection = null;
        newRequirement = new RequirementDto { Title = "" };
        StateHasChanged();
    }

    private void HandleRequirementUpdate(RequirementDto updatedRequirement)
    {
        var index = requirements.FindIndex(r => r.Id == updatedRequirement.Id);
        if (index >= 0)
        {
            requirements[index] = updatedRequirement;
        }
        StateHasChanged();
    }

    private async Task HandleRequirementDelete(RequirementDto requirementToDelete)
    {
        try
        {
            var success = await RequirementsService.DeleteAsync(requirementToDelete.Id);
            if (success)
            {
                requirements.RemoveAll(r => r.Id == requirementToDelete.Id);
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error deleting requirement: {ex.Message}");
        }
    }
}