@page "/testplans"
@page "/projects/{ProjectId:int}/testplans"
@attribute [Authorize]
@using RqmtMgmtShared
@inject ITestPlanService TestPlanService
@inject IProjectService ProjectService
@inject IProjectContextService ProjectContextService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<PageTitle>Test Plans</PageTitle>

<div class="container-fluid">
    @if (project != null)
    {
        <!-- Project Context Header -->
        <div class="project-context-header mb-4">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-2">
                    <li class="breadcrumb-item">
                        <a href="/projects" class="text-decoration-none">
                            <i class="bi bi-folder me-1"></i>Projects
                        </a>
                    </li>
                    <li class="breadcrumb-item active" aria-current="page">@project.Name</li>
                    <li class="breadcrumb-item active" aria-current="page">Test Plans</li>
                </ol>
            </nav>
            <h1 class="h4 mb-1">@project.Name - Test Plans</h1>
            <p class="text-muted mb-0">@project.Description</p>
        </div>
    }
    else
    {
        <!-- Global Test Plans Header -->
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1 class="h3 mb-0">
                <i class="bi bi-clipboard-check me-2"></i>Test Plans
            </h1>
        </div>
    }

    <!-- Search Controls -->
    <div class="row mb-4">
        <div class="col-md-6">
            <div class="input-group">
                <span class="input-group-text">
                    <i class="bi bi-search"></i>
                </span>
                <input type="text" class="form-control" placeholder="Search test plans..." 
                       @bind="searchTerm" @onkeypress="OnSearchKeyPress" />
                <button class="btn btn-outline-secondary" type="button" @onclick="SearchTestPlans">
                    <i class="bi bi-search me-1"></i>Search
                </button>
                @if (!string.IsNullOrEmpty(searchTerm))
                {
                    <button class="btn btn-outline-secondary" type="button" @onclick="ClearSearch">
                        <i class="bi bi-x-circle me-1"></i>Clear
                    </button>
                }
            </div>
        </div>
        <div class="col-md-3">
            <select class="form-select" @bind="sortBy" @bind:after="SortTestPlans">
                <option value="name">Name</option>
                <option value="type">Type</option>
                <option value="created">Created Date</option>
            </select>
        </div>
        <div class="col-md-3">
            <button class="btn btn-success w-100" @onclick="CreateNewTestPlan">
                <i class="bi bi-plus-circle me-1"></i>Add Test Plan
            </button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle me-2"></i>@errorMessage
            <button type="button" class="btn-close" @onclick="() => errorMessage = string.Empty"></button>
        </div>
    }

    @if (pagedResult == null)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <p class="mt-2 text-muted">Loading test plans...</p>
        </div>
    }
    else if (!pagedResult.Items.Any())
    {
        <div class="text-center py-5">
            <i class="bi bi-clipboard-check fa-3x text-muted mb-3"></i>
            <h5 class="text-muted">No Test Plans Found</h5>
            <p class="text-muted mb-0">
                @if (!string.IsNullOrEmpty(searchTerm))
                {
                    <span>No test plans match your current search for @(project != null ? "this project" : "your search criteria").</span>
                }
                else
                {
                    <span>@(project != null ? "This project doesn't have any test plans yet" : "No test plans found"). Get started by creating your first test plan.</span>
                }
            </p>
            <button class="btn btn-primary mt-3" @onclick="CreateNewTestPlan">
                <i class="bi bi-plus-circle me-1"></i>Create First Test Plan
            </button>
        </div>
    }
    else
    {
        <!-- Test Plans Table -->
        <div class="card">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th scope="col" style="width: 80px;">ID</th>
                                <th scope="col">Name</th>
                                <th scope="col">Description</th>
                                <th scope="col" style="width: 150px;">Type</th>
                                <th scope="col" style="width: 150px;">Created</th>
                                <th scope="col" style="width: 200px;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var testPlan in pagedResult.Items)
                            {
                                <tr data-testid="testplan-row">
                                    <td>
                                        <span class="badge bg-light text-dark">@testPlan.Id</span>
                                    </td>
                                    <td>
                                        <strong>@testPlan.Name</strong>
                                    </td>
                                    <td>
                                        <span class="text-muted">@(string.IsNullOrEmpty(testPlan.Description) ? "No description" : testPlan.Description)</span>
                                    </td>
                                    <td>
                                        <span class="badge @GetTypeBadgeClass(testPlan.Type.ToString())">
                                            @GetTypeDisplayName(testPlan.Type.ToString())
                                        </span>
                                    </td>
                                    <td>
                                        <small class="text-muted">@testPlan.CreatedAt.ToString("MMM d, yyyy")</small>
                                    </td>
                                    <td>
                                        <div class="btn-group btn-group-sm" role="group">
                                            <button class="btn btn-outline-primary" @onclick="() => ViewTestPlan(testPlan.Id)" 
                                                    title="View Test Plan" data-testid="view-testplan">
                                                <i class="bi bi-eye"></i>
                                            </button>
                                            <button class="btn btn-outline-secondary" @onclick="() => EditTestPlan(testPlan.Id)" 
                                                    title="Edit Test Plan" data-testid="edit-testplan">
                                                <i class="bi bi-pencil"></i>
                                            </button>
                                            <button class="btn btn-outline-danger" @onclick="() => ConfirmDeleteTestPlan(testPlan)" 
                                                    title="Delete Test Plan" data-testid="delete-testplan">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Pagination -->
        @if (pagedResult.TotalPages > 1)
        {
            <nav aria-label="Test plans pagination" class="mt-3">
                <ul class="pagination justify-content-center">
                    <li class="page-item @(pagedResult.PageNumber == 1 ? "disabled" : "")">
                        <button class="page-link" @onclick="() => GoToPage(pagedResult.PageNumber - 1)">
                            <i class="bi bi-chevron-left"></i>
                        </button>
                    </li>
                    
                    @for (int i = Math.Max(1, pagedResult.PageNumber - 2); i <= Math.Min(pagedResult.TotalPages, pagedResult.PageNumber + 2); i++)
                    {
                        <li class="page-item @(i == pagedResult.PageNumber ? "active" : "")">
                            <button class="page-link" @onclick="() => GoToPage(i)">@i</button>
                        </li>
                    }
                    
                    <li class="page-item @(pagedResult.PageNumber == pagedResult.TotalPages ? "disabled" : "")">
                        <button class="page-link" @onclick="() => GoToPage(pagedResult.PageNumber + 1)">
                            <i class="bi bi-chevron-right"></i>
                        </button>
                    </li>
                </ul>
            </nav>
        }
    }
}
</div>

@code {
    [Parameter] public int? ProjectId { get; set; }
    
    private ProjectDto? project;
    private PagedResult<TestPlanDto>? pagedResult;
    private string? errorMessage;
    private string searchTerm = string.Empty;
    private string sortBy = "name";
    private int currentPage = 1;
    private const int pageSize = 10;

    protected override async Task OnInitializedAsync()
    {
        if (ProjectId.HasValue)
        {
            await LoadProjectAndTestPlans();
        }
        else
        {
            await LoadTestPlans();
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        // Update project context when route parameter changes
        if (ProjectId.HasValue && project?.Id != ProjectId.Value)
        {
            await LoadProjectAndTestPlans();
        }
        else if (!ProjectId.HasValue && project != null)
        {
            // Switched from project-specific to global view
            project = null;
            await ProjectContextService.ClearProjectContextAsync();
            await LoadTestPlans();
        }
    }

    private async Task LoadProjectAndTestPlans()
    {
        try
        {
            // Load project details first
            var projectData = await ProjectService.GetProjectByIdAsync(ProjectId!.Value);
            if (projectData != null)
            {
                this.project = projectData;
                await ProjectContextService.SetCurrentProjectAsync(projectData);
                
                // Load test plans for this project
                await LoadTestPlans();
            }
            else
            {
                errorMessage = "Failed to load project";
                Navigation.NavigateTo("/projects");
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading project: {ex.Message}";
            Console.WriteLine($"Error loading project {ProjectId}: {ex}");
        }
    }

    private async Task LoadTestPlans()
    {
        try
        {
            var request = new PaginationParameters
            {
                PageNumber = currentPage,
                PageSize = pageSize,
                SearchTerm = searchTerm,
                SortBy = sortBy,
                ProjectId = ProjectId // Filter by project if specified
            };

            PagedResult<TestPlanDto>? result;
            
            if (ProjectId.HasValue)
            {
                result = await TestPlanService.GetPagedByProjectIdAsync(ProjectId.Value, request);
            }
            else
            {
                result = await TestPlanService.GetPagedAsync(request);
            }

            if (result != null)
            {
                pagedResult = result;
            }
            else
            {
                errorMessage = "Failed to load test plans";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading test plans: {ex.Message}";
            Console.WriteLine($"Error loading test plans: {ex}");
        }
    }

    private async Task SearchTestPlans()
    {
        currentPage = 1;
        await LoadTestPlans();
    }

    private async Task ClearSearch()
    {
        searchTerm = string.Empty;
        currentPage = 1;
        await LoadTestPlans();
    }

    private async Task SortTestPlans()
    {
        // Delegate to SearchTestPlans
        await SearchTestPlans();
    }

    private async Task GoToPage(int page)
    {
        if (page >= 1 && page <= (pagedResult?.TotalPages ?? 1))
        {
            currentPage = page;
            await LoadTestPlans();
        }
    }

    private async Task OnSearchKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SearchTestPlans();
        }
    }

    private void CreateNewTestPlan()
    {
        if (ProjectId.HasValue)
        {
            Navigation.NavigateTo($"/projects/{ProjectId}/testplans/new");
        }
        else
        {
            Navigation.NavigateTo("/testplans/new");
        }
    }

    private void ViewTestPlan(int testPlanId)
    {
        if (ProjectId.HasValue)
        {
            Navigation.NavigateTo($"/projects/{ProjectId}/testplans/{testPlanId}");
        }
        else
        {
            Navigation.NavigateTo($"/testplans/{testPlanId}");
        }
    }

    private void EditTestPlan(int testPlanId)
    {
        if (ProjectId.HasValue)
        {
            Navigation.NavigateTo($"/projects/{ProjectId}/testplans/{testPlanId}/edit");
        }
        else
        {
            Navigation.NavigateTo($"/testplans/{testPlanId}/edit");
        }
    }

    private void ConfirmDeleteTestPlan(TestPlanDto testPlan)
    {
        // TODO: Implement delete confirmation modal
        Console.WriteLine($"Delete test plan {testPlan.Id}: {testPlan.Name}");
    }

    private string GetTypeBadgeClass(string type)
    {
        return type.ToLower() switch
        {
            "uservalidation" => "bg-info",
            "softwareverification" => "bg-success",
            _ => "bg-secondary"
        };
    }

    private string GetTypeDisplayName(string type)
    {
        return type switch
        {
            "UserValidation" => "User Validation",
            "SoftwareVerification" => "Software Verification",
            _ => type
        };
    }
}

<style>
.project-context-header {
    background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
    padding: 1.5rem;
    border-radius: 0.5rem;
    border-left: 4px solid var(--bs-primary);
}

.btn-group-sm .btn {
    padding: 0.25rem 0.4rem;
}

.table > :not(caption) > * > * {
    padding: 0.75rem 0.5rem;
}

.page-link {
    border: none;
    color: var(--bs-primary);
}

.page-link:hover {
    background-color: var(--bs-light);
    color: var(--bs-primary);
}

.page-item.active .page-link {
    background-color: var(--bs-primary);
    border-color: var(--bs-primary);
}
</style>
