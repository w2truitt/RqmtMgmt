@* DocumentSection.razor - Component for displaying a document section with its requirements *@
@using RqmtMgmtShared
@using frontend.Services

<div class="document-section">
    <div class="section-header-container">
        <h2 class="section-header">
            @Section.SectionOrder. @Section.Title
            @if (!IsReadingMode)
            {
                <button class="btn btn-sm btn-outline-secondary ms-2 d-print-none" @onclick="OnEditSection">
                    <i class="bi bi-pencil"></i>
                </button>
            }
        </h2>
    </div>
    
    @if (!string.IsNullOrEmpty(Section.Description))
    {
        <div class="section-content">
            @Section.Description
        </div>
    }

    <!-- REQUIREMENTS IN THIS SECTION -->
    @if (SectionRequirements.Any())
    {
        <div class="section-requirements">
            @foreach (var requirement in SectionRequirements.OrderBy(r => r.Title))
            {
                <div class="requirement-item">
                    <div class="requirement-header d-flex justify-content-between align-items-start">
                        <div class="requirement-info flex-grow-1">
                            <h4 class="requirement-title">
                                <span class="requirement-id">@requirement.FullRequirementId</span>
                                @requirement.Title
                                <span class="badge bg-secondary ms-2">@requirement.Status</span>
                                <span class="badge bg-light text-dark ms-1">@requirement.Type</span>
                            </h4>
                        </div>
                        @if (!IsReadingMode)
                        {
                            <button class="btn btn-sm btn-outline-primary d-print-none" @onclick="() => OnEditRequirement.InvokeAsync(requirement.Id)">
                                <i class="bi bi-pencil"></i>
                            </button>
                        }
                    </div>
                    
                    @if (!string.IsNullOrEmpty(requirement.Description))
                    {
                        <div class="requirement-description">
                            @requirement.Description
                        </div>
                    }

                    @* Note: AcceptanceCriteria and Rationale not available in current RequirementDto *@
                </div>
            }
        </div>
    }
    else if (!IsReadingMode)
    {
        <div class="no-requirements d-print-none">
            <p class="text-muted fst-italic">No requirements in this section.</p>
            <button class="btn btn-outline-primary btn-sm" @onclick="OnAddRequirement">
                <i class="bi bi-plus me-1"></i>Add Requirement to Section
            </button>
        </div>
    }
</div>

<style>
    .document-section {
        margin-bottom: 2rem;
        page-break-inside: avoid;
    }

    .section-header {
        font-size: 1.5rem;
        color: #333;
        margin-bottom: 1rem;
        border-bottom: 1px solid #ddd;
        padding-bottom: 0.25rem;
    }

    .section-content {
        margin-bottom: 1.5rem;
        padding: 1rem;
        background-color: #f8f9fa;
        border-left: 3px solid #6c757d;
    }

    .section-requirements {
        margin-left: 1rem;
    }

    .requirement-item {
        margin-bottom: 1.5rem;
        padding: 1rem;
        border-left: 3px solid #007bff;
        background-color: #f8f9fa;
        page-break-inside: avoid;
    }

    .requirement-title {
        font-size: 1.1rem;
        margin-bottom: 0.5rem;
    }

    .requirement-id {
        font-weight: bold;
        color: #007bff;
    }

    .requirement-description {
        margin-bottom: 0.75rem;
        line-height: 1.6;
    }

    .requirement-acceptance,
    .requirement-rationale {
        font-size: 0.9rem;
        color: #666;
        margin-bottom: 0.5rem;
    }

    .no-requirements {
        padding: 1rem;
        text-align: center;
        border: 1px dashed #ddd;
        border-radius: 0.375rem;
        margin-left: 1rem;
    }

    /* Print styles */
    @@media print {
        .d-print-none {
            display: none !important;
        }
        
        .document-section {
            page-break-inside: avoid;
            margin-bottom: 1rem;
        }
        
        .requirement-item {
            page-break-inside: avoid;
        }
    }
</style>

@code {
    [Parameter] public DocumentSectionDto Section { get; set; } = new() { Title = "" };
    [Parameter] public List<RequirementDto> SectionRequirements { get; set; } = new();
    [Parameter] public bool IsReadingMode { get; set; } = true;
    [Parameter] public EventCallback OnEditSection { get; set; }
    [Parameter] public EventCallback<int> OnEditRequirement { get; set; }
    [Parameter] public EventCallback OnAddRequirement { get; set; }
}